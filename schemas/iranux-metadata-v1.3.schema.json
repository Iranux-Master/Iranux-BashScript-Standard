{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iranux.org/schemas/iranux-metadata-v1.3.schema.json",
  "title": "Iranux Script Metadata v1.3",
  "description": "The IRANUX_METADATA block of a script declaring schema_version 1.3: the v1.2 metadata plus the optional dns member (specification v1.3 section 5.7). Cross-block and run-time rules (the anchor names a domain or hostname parameter, IRX2004-IRX2005, IRX2012, IRX2021-IRX2023) are not expressible here; the Validator and tools/check_fixtures.py apply them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "script",
    "risk",
    "ui"
  ],
  "properties": {
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema_version"
      ],
      "properties": {
        "name": {
          "const": "iranux-script-metadata"
        },
        "schema_version": {
          "const": "1.3"
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "minLength": 3,
          "maxLength": 64
        },
        "name": {
          "$ref": "#/$defs/label"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "i18n": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Z]{2})?$": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "name"
                  ]
                },
                {
                  "required": [
                    "description"
                  ]
                }
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/label"
                },
                "description": {
                  "$ref": "#/$defs/description"
                }
              }
            }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "safe",
            "low",
            "medium",
            "high",
            "dangerous"
          ]
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires_root": {
          "type": "boolean",
          "default": false
        },
        "requires_internet": {
          "type": "boolean",
          "default": false
        },
        "supported_os": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required_commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.+-]+$"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "action",
        "icon"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/group"
        },
        "action": {
          "$ref": "#/$defs/group"
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "library",
            "name"
          ],
          "properties": {
            "library": {
              "const": "mdi"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "minLength": 1
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records"
      ],
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/dnsRecord"
          }
        },
        "wait": {
          "enum": [
            "authoritative",
            "none"
          ],
          "default": "authoritative"
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "dnsName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:(?:(?!xn--)[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9])?\\.)*\\{anchor\\}|(?:(?!xn--)[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9])?|[a-z0-9][a-z0-9-]{0,39}\\{anchor\\.label\\}(?:[a-z0-9-]{0,39}[a-z0-9])?|\\{anchor\\.label\\}[a-z0-9-]{0,39}[a-z0-9])\\.\\{anchor\\.parent\\})$"
    },
    "dnsPurpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "dnsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchor",
        "name",
        "type",
        "value",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!status$)[a-z][a-z0-9-]{0,31}$"
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "name": {
          "$ref": "#/$defs/dnsName"
        },
        "type": {
          "enum": [
            "A",
            "AAAA",
            "CNAME",
            "TXT",
            "MX",
            "CAA",
            "NS"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ttl": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "default": 300
        },
        "proxy": {
          "const": "off",
          "default": "off"
        },
        "phase": {
          "enum": [
            "before_run",
            "after_run"
          ],
          "default": "before_run"
        },
        "when": {
          "const": "server.ipv6"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "exclusive": {
          "type": "boolean",
          "default": false
        },
        "purpose": {
          "$ref": "#/$defs/dnsPurpose"
        },
        "i18n": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Z]{2})?$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "purpose"
              ],
              "properties": {
                "purpose": {
                  "$ref": "#/$defs/dnsPurpose"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "A"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "{server.ipv4}"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "AAAA"
              }
            }
          },
          "then": {
            "required": [
              "when"
            ],
            "properties": {
              "value": {
                "const": "{server.ipv6}"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "CNAME",
                  "NS",
                  "MX"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/dnsName"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TXT"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "pattern": "^[\\x20\\x21\\x23-\\x5B\\x5D-\\x7E]{1,512}$",
                    "not": {
                      "pattern": "\\{"
                    }
                  },
                  {
                    "pattern": "^\\{output\\.[a-z][a-z0-9_]*\\}$"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "CAA"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^(0|128) (issue|issuewild|iodef) \"[\\x20\\x21\\x23-\\x7E]{0,255}\"$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "MX"
              }
            }
          },
          "then": {
            "required": [
              "priority"
            ]
          },
          "else": {
            "not": {
              "required": [
                "priority"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "pattern": "^\\{output\\."
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "required": [
              "phase"
            ],
            "properties": {
              "phase": {
                "const": "after_run"
              },
              "type": {
                "const": "TXT"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "when"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "AAAA"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "CNAME",
                  "NS"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "exclusive": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
